{{/*
  Document shell. A page template does:
    {{template "doc-start" .Doc}} … components … {{template "doc-end"}}
  .Doc is a ui.Doc. htmx is vendored under static/js so the controls work
  with no internet; the fonts degrade to the system stack when offline.
*/}}
{{define "doc-start"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · Chorus</title>
<link rel="icon" href="{{.Static}}/img/chorus-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="{{.Static}}/css/chorus.css">
<script src="{{.Static}}/js/htmx.min.js" defer></script>
</head>
<body>
<div class="page">
{{with .Notice}}{{template "notice" .}}{{end}}
{{end}}

{{define "doc-end"}}
</div>
</body>
</html>
{{end}}
