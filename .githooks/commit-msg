#!/bin/sh
# Rejects non-Conventional-Commits subjects before the commit exists, so the
# author fixes a message instead of rewriting history (CONTRIBUTING.md §4).
set -e

subject=$(head -1 "$1")

# Merge, revert, and fixup commits are generated by git; leave them alone.
case "$subject" in
	"Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|perf|test|docs|style|chore|build|ci|revert)(\([a-z0-9._-]+\))?!?: .+'; then
	cat >&2 <<MSG
commit-msg: subject is not Conventional Commits.

  got:  $subject
  want: type(scope): imperative summary

  types: feat fix refactor perf test docs style chore build ci revert
  scopes used here: session, esphome, journal, registry, gen, deps, docs

See CONTRIBUTING.md §4.
MSG
	exit 1
fi

if [ ${#subject} -gt 72 ]; then
	echo "commit-msg: subject is ${#subject} chars; keep it under 72." >&2
	exit 1
fi
