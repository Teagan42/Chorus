# Secrets — device PSKs live here, never in git.
devices.yaml
# Enrolled voiceprints: biometric, and unlike a PSK they cannot be rotated.
identities.yaml
*.local.yaml
.env
# The household's MCP servers: a header may carry a token written in place.
mcp.yaml
# ESPHome resolves !secret from here; it holds the same PSK as devices.yaml.
esphome/secrets.yaml
# Flashable firmware embeds the PSK.
esphome/*.bin

# Build output
/bin/
/dist/

# Captured audio from spikes
/tmp/
*.wav
*.pcm
# except the household fixture's voices, which are synthetic (voice.json).
!internal/reviewui/household/audio/**/*.pcm
# and the canned lines' fallback, which Kokoro renders (task canned:voice).
!internal/satellite/fallback/*.pcm

# The speaker-ID model `task speakerid:serve` fetches; pinned, so never committed.
.models/
# The wake-word pipeline's working directory: household audio (docs/wake-retraining.md).
/.wake/

# Tool caches
.buf-cache/
.task/
__pycache__/
.esphome/
# The uv workspace's environment and the sidecar test caches.
.venv/
.pytest_cache/
.ruff_cache/
.claude/worktrees/

# The docs site, built by `task docs:build`.
/site/
