# Copy to .env, which is gitignored. A committed credential cannot be
# un-leaked by a later commit.

# Postgres password for the docker-compose journal database.
POSTGRES_PASSWORD=chorus

# What the orchestrator and the review UI connect to (`task test:db` reads it
# from the shell, not this file). The default in
# internal/journal matches the docker-compose service, so this is only needed
# to point at a database somewhere else.
CHORUS_POSTGRES_DSN=postgres://chorus:chorus@localhost:5432/chorus?sslmode=disable

# Where chorusd accepts satellites dialing in for audio. The port is the one
# the firmware dials (esphome/packages/chorus-bridge.yaml); the address must
# be one the devices can reach, so not loopback.
CHORUS_LISTEN=:6055

# Where chorusd serves /healthz, /readyz and /metrics (ADR-0068). Loopback by
# default: nothing there asks who is asking, and the counters say when the
# house is talking, so serving it to the LAN is a choice. `off` serves none.
# docker-compose sets :6056 inside the container and publishes it on the
# host's loopback only.
#CHORUS_OPS_LISTEN=127.0.0.1:6056

# The names the review UI answers as (cmd/reviewui -hosts): a request whose
# Host header names anything else is refused before it reaches a screen, so
# a web page that re-points its own domain at this box gets nothing. Unset,
# the UI answers as the host it listens on, or as localhost, 127.0.0.1 and
# ::1 when that is loopback (the default) or every interface.
#CHORUS_REVIEWUI_HOSTS=review.home,10.0.0.5

# true starts the review UI read-only (cmd/reviewui -read-only): no screen
# offers to delete a conversation, drop a clip or forget a memory, and those
# routes refuse (ADR-0070). Verdicts and labels still work. A value that is
# not a boolean stops it from starting.
#CHORUS_REVIEWUI_READ_ONLY=true

# Where chorusd keeps the audio the journal refers to: raw PCM, roughly
# 115 MB an hour of continuous capture, so a disk with room rather than the
# repo. Required, and read by the review UI too.
CHORUS_BLOB_DIR=./blobs

# Below this much free space, in MiB, on that directory's filesystem, audio
# is not written: turns go on, and the journal says the clip was not kept
# (ADR-0065). Default 1024; 0 turns the guard off.
#CHORUS_BLOB_MIN_FREE_MIB=1024

# How long, in milliseconds, a wake waits for the same wake from the other
# satellites before the loudest one answers and the rest stay silent
# (ADR-0072). Default 200: wider than Wi-Fi jitter and the spread between two
# devices' detections, and spent while the person is still speaking. A wake
# with no other satellite linked never waits. 0 turns arbitration off, and
# every satellite that hears a wake answers it.
#CHORUS_WAKE_ARBITRATION_MS=200

# The household's MCP servers, whose tools the model is offered as
# mcp_<server>_<tool> under conservative defaults: identified people only,
# every call held for a yes, cancelled at five seconds (ADR-0075). Copy
# mcp.example.yaml; unset, chorusd talks to no MCP server. Tokens the file
# names as ${NAME} are read from here.
# Under docker compose, mount the file into the chorusd service and point
# this at its path there; the image holds chorusd alone, so a server it
# would start by command cannot run in it, and only url servers work.
#CHORUS_MCP_CONFIG=./mcp.yaml
#WEATHER_MCP_TOKEN=

# Which turn engine answers: ollama (the default) or vllm (ADR-0077). The
# review UI reads the same variables, so Replay re-runs on the same engine.
#CHORUS_LLM_PROVIDER=ollama

# The Ollama turn engine (internal/provider/ollama). Both required when it
# is the provider: the model name is recorded against every event, so there
# is no default to drift from.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# The vLLM turn engine (internal/provider/vllm), when CHORUS_LLM_PROVIDER is
# vllm. URL and model are required then; the model is the name the server
# serves it as. Start the server with the flags ADR-0077 names, at least:
#   vllm serve Qwen/Qwen3-32B-AWQ --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3
# The key is the server's --api-key, sent as a bearer token. Thinking is off
# unless VLLM_THINKING is true: Qwen3's reasoning comes before its first
# word, against a 700 ms budget to first audio (SPEC §11).
#VLLM_URL=http://127.0.0.1:8000
#VLLM_MODEL=Qwen/Qwen3-32B-AWQ
#VLLM_API_KEY=
#VLLM_THINKING=false

# An embedding model on Ollama, for recalling what is relevant to what was
# just said once a person has more than 20 memories or 5 conversations to
# choose from (ADR-0044). Served by Ollama whichever engine answers turns,
# so OLLAMA_URL is needed for it under vllm too. Optional: unset, a turn is
# told the newest, which chorusd says at startup.
# `ollama pull nomic-embed-text`.
#OLLAMA_EMBED_MODEL=nomic-embed-text

# The household's time zone, which every turn is told the time in, so that
# "yesterday" is the right day (ADR-0043). Unset is UTC in the container and
# the host's zone under `task run`; chorusd logs the zone at startup.
#TZ=America/Los_Angeles

# Speech synthesis (internal/provider/kokoro) and recognition
# (internal/provider/speaches). Each required while its provider is the
# default (below); the compose ports are the
# defaults. `task tts:up` and `task stt:up` start them locally.
#
# On an Apple Silicon Mac, `task tts:serve` serves the same endpoint on the
# same port from the GPU instead, several times faster (ADR-0092). Only one of
# the two can hold the port; chorusd in Compose reaches a host process at
# http://host.docker.internal:8880, and the sidecar then needs --host 0.0.0.0.
KOKORO_URL=http://127.0.0.1:8880
STT_URL=http://127.0.0.1:8000

# Which voice speaks and which ear hears (ADR-0081): kokoro and speaches (the
# defaults, above), openai for any server with OpenAI's audio API (OpenAI,
# Groq, LocalAI, whisper.cpp, openedai-speech), or wyoming for Home
# Assistant's Wyoming services (wyoming-piper, wyoming-faster-whisper). Each
# provider's variables below are required only when it is chosen. Models and
# voices have no defaults: each is recorded against every event.
#CHORUS_TTS_PROVIDER=kokoro
#CHORUS_STT_PROVIDER=speaches

# The openai voice and ear. A URL is accepted with or without its /v1; a key
# is sent as a bearer token and never logged.
#OPENAI_TTS_URL=https://api.openai.com
#OPENAI_TTS_MODEL=gpt-4o-mini-tts
#OPENAI_TTS_VOICE=nova
#OPENAI_TTS_API_KEY=
#OPENAI_STT_URL=https://api.groq.com/openai
#OPENAI_STT_MODEL=whisper-large-v3-turbo
#OPENAI_STT_API_KEY=

# The wyoming voice and ear, as host:port (tcp:// is fine). The ear's model
# is not sent -- the server runs what it was started with -- so name it as
# you started it: it is what the journal records.
#WYOMING_TTS_ADDR=homeassistant.local:10200
#WYOMING_TTS_VOICE=en_US-lessac-medium
#WYOMING_STT_ADDR=homeassistant.local:10300
#WYOMING_STT_MODEL=faster-whisper/small-int8

# Sent to whichever ear is chosen, when set. Parakeet ignores it; Whisper
# honours it.
#STT_LANGUAGE=en

# Speaker identification (internal/provider/speakerid). chorusd starts
# without it, but answers nothing: a session opens only for an enrolled
# household voice, so unset, or with nobody enrolled, every wake, a button
# press included, is rejected as unknown_speaker. Barge-in then gates on
# energy and words alone. The review UI's Voices screen and `task enroll`
# enroll through it too. `task speakerid:up` or `task speakerid:serve`
# starts it.
SPEAKERID_URL=http://127.0.0.1:8890

# The cosine at or above which a voice is the enrolled person it is nearest.
# Unset keeps identity.DefaultAccept, 0.70, measured on close-mic enrollment
# takes. A front end that rides its own gain compresses every score: measured
# on a Voice PE 2026-10-13, a household's own short commands scored 0.45 to
# 0.79 against their own voiceprint while a second enrolled voice never passed
# 0.43 against it -- so who was speaking stayed clear while the absolute score
# fell under the default and every wake was refused. Lower it only against
# measurements from your own room, and only with more than one voice enrolled:
# it is the one number standing between the household and the television
# (ADR-0084).
#CHORUS_SPEAKER_ACCEPT=0.50

# Whether a call that would be held waits for the person's yes: on (the
# default) or off. Off runs it as written, with no nonce and no question --
# including a lock or a garage door, so it is the household's own trade
# between being asked and being obeyed.
#
# Measured 2026-10-13, the asking could not work here at all: a nonce expires
# once more than one thing has been said since it was handed out, and a turn
# on qwen3:14b takes 3.5 to 5.7 s with thinking on, so the person answers,
# says something else, and the model re-calls with a nonce that died in
# between -- permanently one behind. See ADR-0091.
#CHORUS_CONFIRM=off

# Semantic endpointing (internal/provider/smartturn). Optional: unset, every
# turn ends after 800 ms of quiet, which chorusd says at startup.
# `task smartturn:up` or `task smartturn:serve` starts it.
SMARTTURN_URL=http://127.0.0.1:8891

# The bands Smart Turn's probability is read in. At or above SURE a turn ends
# at the pause; under DOUBT it is held for up to 2 s; between them it ends
# after Energy's 800 ms, as if nobody had judged it. Each
# utterance_transcribed journals turn_end and turn_probability, which is
# what to tune these from: if the household's finished commands keep landing
# as "unsure", lower SURE. Equal values are the single 0.5-style cut chorusd
# had before the bands. See ADR-0094.
#CHORUS_SMARTTURN_SURE=0.8
#CHORUS_SMARTTURN_DOUBT=0.3

# Home Assistant, for the ha_* tools (internal/hass). The token is a
# long-lived access token from your HA profile page; it is sent as a bearer
# header and never logged or quoted in an error. Optional as a pair: unset,
# the ha_* tools stay declared and answer not_implemented, which the model
# sees. Left commented because half a pair is refused at startup, so a copy
# of this file has to start the daemon as it is.
#HASS_URL=http://homeassistant.local:8123
#HASS_TOKEN=
