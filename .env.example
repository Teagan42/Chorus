# Copy to .env, which is gitignored. A committed credential cannot be
# un-leaked by a later commit.

# Postgres password for the docker-compose journal database.
POSTGRES_PASSWORD=chorus

# What the orchestrator and `task test:db` connect to. The default in
# internal/journal matches the docker-compose service, so this is only needed
# to point at a database somewhere else.
CHORUS_POSTGRES_DSN=postgres://chorus:chorus@localhost:5432/chorus?sslmode=disable

# Where chorusd accepts satellites dialing in for audio. The port is the one
# the firmware dials (esphome/packages/chorus-bridge.yaml); the address must
# be one the devices can reach, so not loopback.
CHORUS_LISTEN=:6055

# The names the review UI answers as (cmd/reviewui -hosts): a request whose
# Host header names anything else is refused before it reaches a screen, so
# a web page that re-points its own domain at this box gets nothing. Unset,
# the UI answers as the host it listens on, or as localhost, 127.0.0.1 and
# ::1 when that is loopback (the default) or every interface.
#CHORUS_REVIEWUI_HOSTS=review.home,10.0.0.5

# Where chorusd keeps the audio the journal refers to: raw PCM, roughly
# 115 MB per day of continuous capture, so a disk with room rather than the
# repo. Required.
CHORUS_BLOB_DIR=./blobs

# The turn engine (internal/provider/ollama). Both required: the model name
# is recorded against every event, so there is no default to drift from.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# An embedding model on the same endpoint, for recalling what is relevant to
# what was just said once a person has more than 20 memories or 5
# conversations to choose from (ADR-0044). Optional: unset, a turn is told
# the newest, which chorusd says at startup. `ollama pull nomic-embed-text`.
#OLLAMA_EMBED_MODEL=nomic-embed-text

# The household's time zone, which every turn is told the time in, so that
# "yesterday" is the right day (ADR-0043). Unset is UTC in the container and
# the host's zone under `task run`; chorusd logs the zone at startup.
#TZ=America/Los_Angeles

# Speech synthesis (internal/provider/kokoro) and recognition
# (internal/provider/speaches). Both required; the compose ports are the
# defaults. `task tts:up` and `task stt:up` start them locally.
KOKORO_URL=http://127.0.0.1:8880
STT_URL=http://127.0.0.1:8000

# Speaker identification (internal/provider/speakerid). Optional: unset,
# every speaker is a guest and barge-in gates on energy and words alone, so
# the television can interrupt, which chorusd says at startup.
# `task speakerid:up` or `task speakerid:serve` starts it.
SPEAKERID_URL=http://127.0.0.1:8890

# Semantic endpointing (internal/provider/smartturn). Optional: unset, every
# turn ends after 800 ms of quiet, which chorusd says at startup.
# `task smartturn:up` or `task smartturn:serve` starts it.
SMARTTURN_URL=http://127.0.0.1:8891

# Home Assistant, for the ha_* tools (internal/hass). The token is a
# long-lived access token from your HA profile page; it is sent as a bearer
# header and never logged or quoted in an error. Optional as a pair: unset,
# the ha_* tools stay declared and answer not_implemented, which the model
# sees. Left commented because half a pair is refused at startup, so a copy
# of this file has to start the daemon as it is.
#HASS_URL=http://homeassistant.local:8123
#HASS_TOKEN=
