# Copy to .env, which is gitignored. A committed credential cannot be
# un-leaked by a later commit.

# Postgres password for the docker-compose journal database.
POSTGRES_PASSWORD=chorus

# What the orchestrator and `task test:db` connect to. The default in
# internal/journal matches the docker-compose service, so this is only needed
# to point at a database somewhere else.
CHORUS_POSTGRES_DSN=postgres://chorus:chorus@localhost:5432/chorus?sslmode=disable
